# Minzdrav — ЕМИАС (Production, не локально)
# Скопируйте в .env и заполните

# Discord Bot (Department-Oversight)
DISCORD_TOKEN=your_bot_token_here
TEST_BOT_TOKEN=your_test_token

# Database — для хостинга используйте Postgres (рекомендуется)
# Локально: file:./Minzdrav/data/emias.db  (SQLite) — ЗАКОММЕНТИРОВАТЬ
# Продакшн: postgresql://user:password@host:5432/emias?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/emias

# Альтернатива для SQLite файла (если не Postgres) — ЗАКОММЕНТИРОВАТЬ
# DB_PATH=./Minzdrav/data/emias.db
# DATABASE_URL=file:./Minzdrav/data/emias.db

# Staff — Discord ID главного врача (через запятую)
# ADMIN_DISCORD_IDS=123456789012345678

# Webhooks (опционально)
# DISCORD_WEBHOOK_APPOINTMENTS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_CARDS=https://discord.com/api/webhooks/...

# Логи
# STAFF_LOG_CHANNEL_ID=123456789012345678
# CARD_FORUM_CHANNEL_ID=123456789012345678
